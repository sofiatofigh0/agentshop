# Live mode is OFF unless this is exactly "true". Demo mode needs no key at all.
ENABLE_LIVE_DEMO=false

# Server-side only. Never prefix with NEXT_PUBLIC_ — that would ship it to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Live-mode limits (all enforced server-side)
MAX_JD_CHARS=12000
MAX_SEARCHES=2
