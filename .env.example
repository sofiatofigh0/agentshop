# Copy this file to .env and fill in your key. .env is gitignored.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional cost controls. All of them can stay blank.
#
# A cheaper model for the extraction-shaped side jobs only — summarizing a web
# search, pulling keywords out of a posting, distilling an edit into a lesson.
# The verdict and every document still come from ANTHROPIC_MODEL. Try
# claude-sonnet-5.
ANTHROPIC_WORKER_MODEL=
# The experience bank stays in the prompt cache for an hour, so runs made in
# one sitting read it instead of re-writing it. Set to 5m if you only ever run
# one posting at a time: the hour costs a little extra on a run made alone.
PROMPT_CACHE_TTL=
# Force one reasoning effort on every step, for comparing settings with
# evals.py: low, medium, high, xhigh or max. A level the model does not accept
# is clamped down to the nearest one it does. Blank uses the per-step defaults
# in models.py.
ANTHROPIC_EFFORT=
# ATS keyword coverage below which the resume gets one rephrasing pass.
ATS_TARGET_SCORE=75

# Contact details for generated resumes. Kept out of git — this repo is public.
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
# Password for the gated portfolio site, if it has one. Kept out of git.
PORTFOLIO_PASSWORD=
