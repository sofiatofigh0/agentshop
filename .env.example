# Copy this file to .env and fill in your key. .env is gitignored.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional cost controls. All three can stay blank.
#
# A cheaper model for the extraction-shaped side jobs only — summarizing a web
# search, pulling keywords out of a posting, distilling an edit into a lesson.
# The verdict and every document still come from ANTHROPIC_MODEL. Try
# claude-sonnet-5.
ANTHROPIC_WORKER_MODEL=
# Set to 1h when running several postings in one sitting: the experience bank
# is then written to the prompt cache once an hour instead of once a run.
PROMPT_CACHE_TTL=
# Force one reasoning effort on every step (low, medium, high) — for comparing
# settings with evals.py. Blank uses the per-step defaults in models.py.
ANTHROPIC_EFFORT=
# ATS keyword coverage below which the resume gets one rephrasing pass.
ATS_TARGET_SCORE=75

# Contact details for generated resumes. Kept out of git — this repo is public.
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
# Password for the gated portfolio site, if it has one. Kept out of git.
PORTFOLIO_PASSWORD=
